<Window x:Class="CRUD.NovaPostagem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CRUD"
        mc:Ignorable="d"
        Title="Nova Postagem" Height="450" Width="400" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Name="GridPstagem"  Margin="8" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0"
                     Background="
                     LavenderBlush" 
                     Padding="4"
                     FontSize="16"  
                     MaxLength="140"
                     MaxLines="6"
                     MinHeight="180"
                     TextWrapping="Wrap"
                     x:Name="tbConteudo"
                     TextChanged="TbConteudo_OnTextChanged">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="05" />
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <Label Grid.Row="1" Content="0/140"
                   HorizontalAlignment="Right"
                   FontSize="12"
                   FontWeight="Light"
                   x:Name="lblCaracteresMax"/>
        </Grid>

        <Button Grid.Row="2" Background="DeepSkyBlue" Content="Postar" FontSize="20"
                FontWeight="Bold" Margin="8" Padding="8"
                Click="BtnPostar_OnClick">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="05" />
                </Style>
            </Button.Resources>
        </Button>


    </Grid>
</Window>